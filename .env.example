# Database Configuration (Supabase - Free Tier Available)
# Get credentials at: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Legacy Admin Key (for backwards compatibility)
ADMIN_UPLOAD_KEY="19/BM/ANM/617/2204"

# JWT Secret for User Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# Storage Configuration (Supabase - Free Tier: 1GB storage)
# Get credentials at: https://supabase.com/dashboard/project/_/settings/api
STORAGE_MODE="supabase"
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="anatomiq-materials"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth (Free - Get credentials at: https://console.cloud.google.com/apis/credentials)
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth (Free - Get credentials at: https://developers.facebook.com/apps)
# 1. Create a new app
# 2. Add Facebook Login product
# 3. Add redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# OpenAI API Configuration (Free tier available for testing)
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_QUESTION_MODEL="gpt-4o-mini"
OPENAI_EXTRACTION_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
